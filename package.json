{
  "name": "@iflow-mcp/after-effects-mcp",
  "version": "1.0.0",
  "description": "MCP server for Adobe After Effects",
  "main": "build/index.js",
  "bin": {
    "after-effects-mcp": "build/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && cp -r ./src/scripts ./build/scripts 2>/dev/null || true",
    "start": "node build/index.js",
    "install-bridge": "node install-bridge.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-fetch": "^3.3.2",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "typescript": "^5.2.2"
  }
}
